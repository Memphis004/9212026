<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTE: filename kept as "event.xml" only because that's what luban.conf's
  schemaFiles already points to: content here actually covers all tables,
  not just world events. Rename and split into per-table files later if it
  bothers you (edit luban.conf's schemaFiles list to match).

  ChibiPartDef is intentionally NOT defined here yet: its FramesByAnimKey
  field (Dictionary<string, List<string>>) is too nested to model cleanly as
  flat CSV columns. Needs either a JSON sidecar per part or a second flat
  "ChibiPartFrame.csv" (PartId, AnimKey, FrameIndex, SpritePath) aggregated at
  codegen time. Deferred, not blocking this run.
-->
<module name="game">

    <!-- ============ CardDef ============ -->
    <!-- Flattened vs Shared/CardDef.cs's Dictionary<string,float> StatEffect,
         to avoid map-type CSV syntax risk for the first working run. -->
    <bean name="CardDef">
        <var name="id" type="string"/>
        <var name="category" type="string"/>
        <var name="displayName" type="string"/>
        <var name="spritePath" type="string"/>
        <var name="stackLimit" type="int"/>
        <var name="hungerDelta" type="float"/>
        <var name="thirstDelta" type="float"/>
        <var name="moodDelta" type="float"/>
        <var name="fatigueDelta" type="float"/>
        <var name="explorePenalty" type="float"/>
        <var name="craftPenalty" type="float"/>
        <!-- Lab C Phase 1: targeting + effect (เดิมมีแค่ใน Shared/CardDef.cs mock
             ตอนนี้มาจาก CSV จริง เช่น knife_basic = SingleTarget/Eliminate) -->
        <var name="targetType" type="string"/>
        <var name="effectType" type="string"/>
    </bean>
    <table name="TbCardDef" value="CardDef" mode="map" index="id" input="CardDef.csv" group="c"/>

    <!-- ============ LocationDef ============ -->
    <!-- LootTable flattened to 3 fixed (card,weight) slots instead of a map. -->
    <bean name="LocationDef">
        <var name="id" type="string"/>
        <var name="displayName" type="string"/>
        <var name="worldX" type="float"/>
        <var name="worldY" type="float"/>
        <var name="connectedLocationIds" type="(list#sep=;),string"/>
        <var name="lootCard1" type="string"/>
        <var name="lootWeight1" type="int"/>
        <var name="lootCard2" type="string"/>
        <var name="lootWeight2" type="int"/>
        <var name="lootCard3" type="string"/>
        <var name="lootWeight3" type="int"/>
        <var name="capacity" type="int"/>
    </bean>
    <table name="TbLocationDef" value="LocationDef" mode="map" index="id" input="LocationDef.csv" group="c"/>

    <!-- ============ RecipeDef ============ -->
    <!-- Inputs flattened to 2 fixed (card,count) slots instead of a map. -->
    <bean name="RecipeDef">
        <var name="id" type="string"/>
        <var name="outputCardId" type="string"/>
        <var name="outputCount" type="int"/>
        <var name="inputCard1" type="string"/>
        <var name="inputCount1" type="int"/>
        <var name="inputCard2" type="string"/>
        <var name="inputCount2" type="int"/>
        <var name="requiredLocationId" type="string"/>
        <var name="requiredToolCardId" type="string"/>
    </bean>
    <table name="TbRecipeDef" value="RecipeDef" mode="map" index="id" input="RecipeDef.csv" group="c"/>

    <!-- ============ ClueDef ============ -->
    <!-- Clue System v2 (a): + clueCategory (หมวด clue, มาจาก CSV column clueCategory) -->
    <bean name="ClueDef">
        <var name="id" type="string"/>
        <var name="displayName" type="string"/>
        <var name="spritePath" type="string"/>
        <var name="reliability" type="string"/>
        <var name="visibleToBystanders" type="bool"/>
        <var name="clueCategory" type="string"/>
    </bean>
    <table name="TbClueDef" value="ClueDef" mode="map" index="id" input="ClueDef.csv" group="c"/>

    <!-- ============ ActionClueTriggerDef ============ -->
    <!-- Clue System v2 (a): การกระทำแต่ละประเภทปล่อย clue อะไร (weight = ความน่าจะเป็น)
         triggerSource ตรงกับ Marooned.Shared.ClueTriggerSource enum จะถูก map เป็น enum แท้ใน LubanDefMappers.MapActionClueTriggers -->
    <bean name="ActionClueTriggerDef">
        <var name="id" type="string"/>
        <var name="triggerSource" type="string"/>
        <var name="clueDefId" type="string"/>
        <var name="weight" type="int"/>
    </bean>
    <table name="TbActionClueTriggerDef" value="ActionClueTriggerDef" mode="map" index="id" input="ActionClueTriggerDef.csv" group="c"/>

    <!-- ============ IllnessDef ============ -->
    <bean name="IllnessDef">
        <var name="id" type="string"/>
        <var name="displayName" type="string"/>
        <var name="visible" type="bool"/>
        <var name="cureCardId" type="string"/>
        <var name="severityGrowthPerHour" type="float"/>
    </bean>
    <table name="TbIllnessDef" value="IllnessDef" mode="map" index="id" input="IllnessDef.csv" group="c"/>

    <!-- ============ WorldEventDef ============ -->
    <bean name="WorldEventDef">
        <var name="id" type="string"/>
        <var name="group" type="string"/>
        <var name="weight" type="int"/>
        <var name="displayText" type="string"/>
        <var name="requiredLocationTag" type="string"/>
    </bean>
    <table name="TbWorldEventDef" value="WorldEventDef" mode="map" index="id" input="WorldEventDef.csv" group="c"/>

    <!-- ============ BiomeDef ============ -->
    <bean name="BiomeDef">
        <var name="id" type="string"/>
        <var name="displayName" type="string"/>
        <var name="propDensity" type="float"/>
        <var name="itemSpawnRate" type="float"/>
        <var name="backgroundColor" type="string"/>
        <var name="fogDensity" type="float"/>
        <!-- Lab C Phase 1: node ids ที่ spawn ใน biome นี้ (map กับ HarvestableNodeDef.csv)
             — System อ่านจากตาราง ไม่ hardcode -->
        <var name="harvestableNodeIds" type="(list#sep=;),string"/>
    </bean>
    <table name="TbBiomeDef" value="BiomeDef" mode="map" index="id" input="BiomeDef.csv" group="c"/>

    <!-- ============ HarvestableNodeDef ============ -->
    <!-- Clue System v2 (c): + isHuntingTarget — node ที่เก็บแล้วถือว่า "ล่าสัตว์"
         (node_deer) → NodeHarvestSystem hook ClueTriggerSource.Hunting -->
    <bean name="HarvestableNodeDef">
        <var name="id" type="string"/>
        <var name="displayName" type="string"/>
        <var name="requiredToolCardId" type="string"/>
        <var name="yieldItemId" type="string"/>
        <var name="yieldCount" type="int"/>
        <var name="durability" type="int"/>
        <var name="regrowTime" type="int"/>
        <var name="isHuntingTarget" type="bool"/>
    </bean>
    <table name="TbHarvestableNodeDef" value="HarvestableNodeDef" mode="map" index="id" input="HarvestableNodeDef.csv" group="c"/>

    <!-- ============ ZoneConnectionDef ============ -->
    <!-- Hybrid Transition Points (Part 1 — foundation only): จุดเชื่อมโซน
         fromLocationId/toLocationId ต้องมีจริงใน LocationDef.csv และควร
         reference กันแบบสองทาง (A_to_B คู่กับ B_to_A) — transitionX/Y คือ
         ตำแหน่งภายในโซนปลายทางที่ NPC จะโผล่ (enter point) และจุดที่เดิน
         เข้าหาในโซนต้นทาง (exit point) ตาม convention ของ Part 2
         consume เป็น cfg.game.ZoneConnectionDef ตรงๆ (ไม่มี Shared mirror) -->
    <bean name="ZoneConnectionDef">
        <var name="id" type="string"/>
        <var name="fromLocationId" type="string"/>
        <var name="toLocationId" type="string"/>
        <var name="transitionX" type="float"/>
        <var name="transitionY" type="float"/>
    </bean>
    <table name="TbZoneConnectionDef" value="ZoneConnectionDef" mode="map" index="id" input="ZoneConnectionDef.csv" group="c"/>

</module>